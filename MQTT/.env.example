# Salin file ini menjadi MQTT/.env lalu isi nilainya.
# File .env berisi rahasia: JANGAN di-commit / dibagikan ke kelompok lain.
#
# Jika MQTT_BROKER kosong / file .env tidak ada, skrip otomatis memakai
# broker publik broker.hivemq.com:1883 (tanpa TLS) — hanya untuk uji coba.

# Contoh EMQX Cloud Serverless: xxxxxx.ala.asia-southeast1.emqxsl.com
MQTT_BROKER=
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=

# Path file CA (relatif terhadap folder MQTT/), contoh: emqxsl-ca.crt
# Kosongkan untuk memakai sertifikat bawaan sistem.
MQTT_CA_CERT=

# Topik bersama kelompok
MQTT_TOPIC=sister/temp
